# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development. On Vercel, add each variable in
# Project → Settings → Environment Variables (Production, and Preview if you
# want the form to work on preview deployments too), then redeploy.
#
# Never commit real values: every `.env*` file except this one is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Guest form → Google Sheets (server-only, never sent to the browser) ──────
#
# 1. Google Cloud console → enable "Google Sheets API" → create a service
#    account → Keys → Add key → JSON.
# 2. Share the spreadsheet with the service account's e-mail as an Editor.
# 3. Copy `client_email` and `private_key` from the JSON file below.

# The service account's e-mail, e.g. rsvp@your-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# The whole `private_key` value from the JSON file, including the BEGIN/END
# lines, on one line with literal \n — in quotes here. On Vercel, paste it
# without the surrounding quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# The id in the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Optional: the tab to write to. Leave empty to use the first tab.
# A header row is added automatically when the tab is empty.
GOOGLE_SHEET_NAME=

# ── Link previews (WhatsApp, Telegram, Instagram) ───────────────────────────
#
# Optional on Vercel: the production *.vercel.app domain is detected on its
# own. Set this when the invitation is served from a custom domain, so the
# preview image URL points at it.
# NEXT_PUBLIC_SITE_URL=https://kutman-aiturgan.vercel.app
