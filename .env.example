# The central RSVP API the guest form posts to. The Invitation Admin sets this
# on every generated deployment; without it the form falls back to the absolute
# URL the admin writes into data/invitation.ts.
NEXT_PUBLIC_RSVP_API_URL=https://invitation-rsvp-api.vercel.app

# The public origin of this invitation, used for metadataBase. The admin sets
# it per deployment; locally it may be left unset.
# NEXT_PUBLIC_SITE_URL=https://example.com
